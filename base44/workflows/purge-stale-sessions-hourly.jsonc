{
  "name": "purge-stale-sessions-hourly",
  "description": "Module 20: every hour, revoke AppSession rows idle more than 48h by invoking purgeStaleSessions.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 * * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "do": [
      {
        "reap": {
          "call": "invoke_backend_function",
          "then": "end",
          "with": {
            "function_name": "purgeStaleSessions"
          }
        }
      }
    ],
    "document": {
      "dsl": "1.0.0",
      "name": "purge-stale-sessions",
      "namespace": "base44",
      "version": "1.0.0"
    }
  }
}