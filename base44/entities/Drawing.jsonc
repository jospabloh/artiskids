{
  "name": "Drawing",
  "properties": {
    "album": {
      "type": "string"
    },
    "creator_name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "drawn_date": {
      "format": "date",
      "type": "string"
    },
    "family_id": {
      "description": "Tenant boundary \u2014 the family this drawing belongs to.",
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "title": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "image_url",
    "creator_name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.family_id": "{{user.data.family_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.family_id": "{{user.data.family_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.family_id": "{{user.data.family_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.family_id": "{{user.data.family_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "type": "object"
}