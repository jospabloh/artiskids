{
  "name": "Drawing",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "drawn_date": {
      "type": "string",
      "format": "date"
    },
    "creator_name": {
      "type": "string"
    },
    "album": {
      "type": "string"
    },
    "family_id": {
      "type": "string",
      "description": "Tenant boundary — the family this drawing belongs to."
    }
  },
  "required": [
    "title",
    "image_url",
    "creator_name"
  ],
  "rls": {
    "read": {
      "$or": [
        { "data.family_id": "{{user.data.family_id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "create": {
      "$or": [
        { "data.family_id": "{{user.data.family_id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "update": {
      "$or": [
        { "data.family_id": "{{user.data.family_id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "delete": {
      "$or": [
        { "data.family_id": "{{user.data.family_id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    }
  }
}
