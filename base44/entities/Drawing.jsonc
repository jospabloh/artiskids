{
  "name": "Drawing",
  "properties": {
    "album": {
      "type": "string"
    },
    "creator_name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "drawn_date": {
      "format": "date",
      "type": "string"
    },
    "family_id": {
      "description": "Tenant boundary - the family this drawing belongs to.",
      "type": "string"
    },
    "file_size_bytes": {
      "description": "The uploaded image's byte size, set by content/entry.ts's createDrawing from the client's File.size. Feeds Family.storage_used_bytes -- without a real per-drawing size, the family's running total can't be maintained or reversed on delete.",
      "type": "number"
    },
    "image_url": {
      "type": "string"
    },
    "title": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "image_url",
    "creator_name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.family_id": "{{user.data.family_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.family_id": "{{user.data.family_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.family_id": "{{user.data.family_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.family_id": "{{user.data.family_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "type": "object"
}