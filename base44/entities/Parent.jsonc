{
  "name": "Parent",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "family_id": {
      "type": "string",
      "description": "Tenant boundary — the family this display/label entry belongs to."
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        { "data.family_id": "{{user.data.family_id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "create": {
      "$or": [
        { "data.family_id": "{{user.data.family_id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "update": {
      "$or": [
        { "data.family_id": "{{user.data.family_id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "delete": {
      "$or": [
        { "data.family_id": "{{user.data.family_id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    }
  }
}
