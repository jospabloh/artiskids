{
  "name": "Reaction",
  "properties": {
    "author_name": {
      "type": "string"
    },
    "drawing_id": {
      "type": "string"
    },
    "emoji": {
      "type": "string"
    },
    "family_id": {
      "description": "Tenant boundary — must match the family_id of the drawing_id it reacts to. Not cross-checked by RLS (RLS can't join to Drawing); the Phase 3 Safe function that creates a Reaction re-derives it from the target drawing's own family_id, never trusting the client's value.",
      "type": "string"
    }
  },
  "required": [
    "drawing_id",
    "emoji"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.family_id": "{{user.data.family_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.family_id": "{{user.data.family_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.family_id": "{{user.data.family_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.family_id": "{{user.data.family_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "type": "object"
}