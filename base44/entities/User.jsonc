{
  "name": "User",
  "properties": {
    "family_id": {
      "description": "The one family this user belongs to. This field IS the membership record (Module 18, retired 2026-09-10) - no separate Membership entity, no tenant switcher. Write-locked: only Phase 3's createFamily/redeemCode/setMemberRole functions (running as service role) may set it, never the user themselves.",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      },
      "type": "string"
    },
    "family_role": {
      "description": "Role within family_id. Same write lock as family_id, same reasoning.",
      "enum": [
        "family_admin",
        "member"
      ],
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      },
      "type": "string"
    },
    "pending_family_id": {
      "description": "A join request waiting on that family's admin (Module 2: an invite code requests access, it never grants it). Set by redeemCode, cleared by approveJoinRequest/rejectJoinRequest/cancelJoinRequest. Grants nothing: every RLS rule compares family_id, never this. Write-locked like family_id, so a user cannot point it at a family or approve themselves.",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      },
      "type": "string"
    },
    "role": {
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ],
      "type": "string"
    }
  },
  "required": [
    "role"
  ],
  "type": "object"
}