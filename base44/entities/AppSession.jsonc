{
  "name": "AppSession",
  "properties": {
    "family_id": {
      "description": "Tenant boundary. Write-locked -- only the session function (service role) sets it, re-derived from the caller's own User.family_id, never trusted from the request body.",
      "rls": {
        "write": { "user_condition": { "role": "admin" } }
      },
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "device": {
      "description": "A short human-readable label for the device/browser (from the user agent), shown in the device list -- never the raw user agent string.",
      "type": "string"
    },
    "status": {
      "description": "active = currently in use; passive = idle past the client warning but not yet reaped; revoked = force-logged-out (by the user, an admin, or the 48h reap job).",
      "enum": ["active", "passive", "revoked"],
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "type": "string"
    },
    "last_active_at": {
      "format": "date-time",
      "type": "string"
    },
    "revoked_at": {
      "format": "date-time",
      "type": "string"
    },
    "revoked_by": {
      "description": "Email of who revoked it (self, another family member, or 'system' for the reap job), or null.",
      "type": "string"
    }
  },
  "required": ["family_id", "user_email", "status", "started_at", "last_active_at"],
  "rls": {
    "create": {
      "$or": [
        { "data.family_id": "{{user.data.family_id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "delete": {
      "$or": [
        { "data.family_id": "{{user.data.family_id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "read": {
      "$or": [
        { "data.family_id": "{{user.data.family_id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "update": {
      "$or": [
        { "data.family_id": "{{user.data.family_id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    }
  },
  "type": "object"
}
