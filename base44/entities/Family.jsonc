{
  "name": "Family",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Display name for the family, e.g. \"Familia Herrera\"."
    },
    "join_code": {
      "type": "string",
      "description": "Shareable code a new member redeems to join this family. Unique, generated server-side by the createFamily function (Phase 3)."
    },
    "billing_status": {
      "type": "string",
      "enum": ["trial", "active", "view_only", "suspended"],
      "description": "Governs what the family can do (Module 1). Write-locked: only Mission Control's unified license cron or this app's own service-role functions may set it — never a family member, regardless of role.",
      "rls": {
        "write": { "user_condition": { "role": "admin" } }
      }
    },
    "license_plan": {
      "type": "string",
      "description": "Mercado Pago plan id once billing_status leaves trial. Null during trial. Same write lock as billing_status — set only by the billing function.",
      "rls": {
        "write": { "user_condition": { "role": "admin" } }
      }
    },
    "trial_end_at": {
      "type": "string",
      "format": "date-time",
      "description": "Set once at family creation (created_at + 30 days, server time). Write-locked so a member can't extend their own trial.",
      "rls": {
        "write": { "user_condition": { "role": "admin" } }
      }
    },
    "license_expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Current paid-period end. Write-locked, same reasoning as trial_end_at.",
      "rls": {
        "write": { "user_condition": { "role": "admin" } }
      }
    },
    "created_by_email": {
      "type": "string",
      "description": "Email of the user who created the family (its first family_admin)."
    }
  },
  "required": ["name", "billing_status"],
  "rls": {
    "read": {
      "$or": [
        { "id": "{{user.data.family_id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "create": { "user_condition": { "role": "admin" } },
    "update": {
      "$or": [
        { "id": "{{user.data.family_id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
